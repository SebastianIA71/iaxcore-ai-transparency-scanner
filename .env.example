# Supabase project: iaxcore-scanner (org fcozdnfiftasajtllfbz, eu-west-1, ref pttuhidqppmnuxrbmqpt)
NEXT_PUBLIC_SUPABASE_URL=https://pttuhidqppmnuxrbmqpt.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Prisma — direct connection (required for the worker's SKIP LOCKED queue polling)
DATABASE_URL=

# Prisma — pooled connection (pgbouncer, transaction mode; safe for the web app's simple queries)
DATABASE_POOLED_URL=

# Local dev via `docker compose up` (no pgbouncer — both vars point at the
# same instance): DATABASE_URL=DATABASE_POOLED_URL=postgresql://iaxcore:iaxcore@localhost:5432/iaxcore

# Firma Ed25519 del JSON canónico del informe (§8, §19) — no del PDF.
# Genera con packages/core's generateSigningKeyPair(); SIGNING_PRIVATE_KEY_B64
# es un secreto real, nunca lo commitees. La pública se publica tal cual en
# /.well-known/iaxcore-keys.json.
SIGNING_KEY_ID=
SIGNING_PUBLIC_KEY_B64=
SIGNING_PRIVATE_KEY_B64=
